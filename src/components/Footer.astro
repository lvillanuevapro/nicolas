---
const redes = [
  { label: 'Instagram', href: 'https://instagram.com/impulsorionegro' },
  { label: 'Facebook',  href: 'https://facebook.com/impulsorionegro' },
  { label: 'X',         href: 'https://x.com/impulsorionegro' },
  { label: 'YouTube',   href: 'https://youtube.com/@impulsorionegro' },
  { label: 'LinkedIn',  href: 'https://linkedin.com/in/nsuarezcolman' },
];
---

<footer class="bg-[#0E0B12] text-white">
  <div class="h-1 w-full" style="background: linear-gradient(90deg, #6A287F 0%, #6A287F 60%, #F97B00 60%, #F97B00 90%, #55A3B2 90%)"></div>

  <div class="max-w-6xl mx-auto px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Col 1: marca + contacto -->
      <div>
        <div class="mb-5">
          <img src="/logo-impulso-dark.jpg" alt="IMPULSO Río Negro" class="h-14 w-auto" />
        </div>
        <p class="text-white/50 text-sm leading-relaxed mb-5">
          Partido liberal de distrito con identidad provincial.<br>
          Construimos desde Río Negro, para Río Negro.
        </p>
        <div class="text-sm text-white/50 leading-loose">
          <span class="block font-montserrat font-bold text-[10px] uppercase tracking-widest text-[#F97B00] mb-1">Contacto</span>
          nsuarezcolman@gmail.com<br>
          General Roca · Río Negro · Argentina
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-5">
          {redes.map(r => (
            <a href={r.href} target="_blank" rel="noopener"
               class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-white/40 hover:text-[#F97B00] transition-colors">
              {r.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Col 2: páginas -->
      <div>
        <h4 class="font-montserrat font-bold text-[10px] uppercase tracking-widest text-white/30 mb-5">Páginas</h4>
        {[
          ['Inicio',      '/'],
          ['Conoceme',    '/conoceme'],
          ['Propuestas',  '/propuestas'],
          ['Columnas',    '/columnas'],
          ['Prensa',      '/prensa'],
          ['Sumate',      '/sumate'],
        ].map(([label, href]) => (
          <a href={href} class="block font-montserrat font-bold text-[12px] text-white/50 hover:text-[#F97B00] transition-colors mb-2">{label}</a>
        ))}
      </div>

      <!-- Col 3: partido -->
      <div>
        <h4 class="font-montserrat font-bold text-[10px] uppercase tracking-widest text-white/30 mb-5">El partido</h4>
        {[
          ['Sitio de IMPULSO Río Negro ↗', 'https://impulsorionegro.ar'],
          ['Kit de prensa',                '/prensa#kit'],
          ['Afiliación',                   '/sumate'],
        ].map(([label, href]) => (
          <a href={href} class="block font-montserrat font-bold text-[12px] text-white/50 hover:text-[#F97B00] transition-colors mb-2">{label}</a>
        ))}
      </div>

    </div>

    <!-- Pie legal -->
    <div class="border-t border-white/10 mt-12 pt-6 flex flex-col md:flex-row justify-between items-start gap-2">
      <span class="font-montserrat text-[11px] text-white/25">
        Sitio personal de Nicolás Suárez Colman · Presidente de IMPULSO Río Negro
      </span>
      <span class="font-montserrat text-[11px] text-white/20 italic">
        Liberal de acá. Eso somos.
      </span>
    </div>
  </div>
</footer>
