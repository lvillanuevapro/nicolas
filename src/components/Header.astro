---
const nav = [
  { label: 'Inicio',      href: '/' },
  { label: 'Conoceme',    href: '/conoceme' },
  { label: 'Propuestas',  href: '/propuestas' },
  { label: 'Columnas',    href: '/columnas' },
  { label: 'Prensa',      href: '/prensa' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white border-b-2 border-[#6A287F] shadow-sm">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-[68px]">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 no-underline">
      <svg width="48" height="38" viewBox="0 0 200 158" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="IMPULSO Río Negro">
        <!-- Ala izquierda (violeta) -->
        <path d="M 100 138 C 82 118 44 82 18 50 C 6 35 8 14 20 9 C 27 6 35 12 42 22 C 52 36 68 60 90 92 C 95 103 99 120 100 138 Z" fill="#6A287F"/>
        <!-- Ala derecha (naranja) -->
        <path d="M 100 138 C 118 118 156 82 182 50 C 194 35 192 14 180 9 C 173 6 165 12 158 22 C 148 36 132 60 110 92 C 105 103 101 120 100 138 Z" fill="#F97B00"/>
        <!-- Estrella de 8 puntas (teal) — centro (100,70), r_ext=22, r_int=9 -->
        <polygon points="100,48 103.4,61.7 115.6,54.4 108.3,66.6 122,70 108.3,73.4 115.6,85.6 103.4,78.3 100,92 96.6,78.3 84.4,85.6 91.7,73.4 78,70 91.7,66.6 84.4,54.4 96.6,61.7" fill="#55A3B2"/>
      </svg>
      <div class="leading-tight">
        <div class="font-montserrat font-bold text-[13px] uppercase tracking-wide text-[#0E0B12]">Nico Suárez Colman</div>
        <div class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-[#6A287F]">Impulso Río Negro</div>
      </div>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex items-center gap-1">
      {nav.map(item => (
        <a
          href={item.href}
          class:list={[
            'font-montserrat font-bold text-[12px] uppercase tracking-wider px-4 py-2 rounded transition-colors',
            current === item.href || (item.href !== '/' && current.startsWith(item.href))
              ? 'text-[#6A287F] bg-[#ede1f2]'
              : 'text-[#0E0B12] hover:text-[#6A287F] hover:bg-[#ede1f2]'
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://impulsorionegro.ar"
        target="_blank"
        rel="noopener"
        class="font-montserrat font-bold text-[12px] uppercase tracking-wider px-4 py-2 rounded bg-[#6A287F] text-white hover:bg-[#4e1a60] transition-colors ml-1"
      >
        Impulso RN ↗
      </a>
      <a
        href="/sumate"
        class="font-montserrat font-bold text-[12px] uppercase tracking-wider px-4 py-2 rounded bg-[#F97B00] text-white hover:bg-orange-600 transition-colors ml-1"
      >
        Sumate
      </a>
    </nav>

    <!-- Hamburger mobile -->
    <button id="menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Abrir menú">
      <span class="block w-6 h-0.5 bg-[#0E0B12]"></span>
      <span class="block w-6 h-0.5 bg-[#0E0B12]"></span>
      <span class="block w-6 h-0.5 bg-[#0E0B12]"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-6 pb-4">
    {nav.map(item => (
      <a
        href={item.href}
        class="block font-montserrat font-bold text-[13px] uppercase tracking-wider py-3 border-b border-gray-100 text-[#0E0B12] hover:text-[#6A287F]"
      >
        {item.label}
      </a>
    ))}
    <a href="https://impulsorionegro.ar" target="_blank" class="block font-montserrat font-bold text-[13px] uppercase tracking-wider py-3 border-b border-gray-100 text-[#6A287F]">Impulso RN ↗</a>
    <a href="/sumate" class="mt-3 block text-center font-montserrat font-bold text-[13px] uppercase tracking-wider py-3 rounded bg-[#F97B00] text-white">Sumate</a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
