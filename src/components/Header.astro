---
const nav = [
  { label: 'Inicio',     href: '/' },
  { label: 'Conoceme',   href: '/conoceme' },
  { label: 'Propuestas', href: '/propuestas' },
  { label: 'Columnas',   href: '/columnas' },
  { label: 'Prensa',     href: '/prensa' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-[68px]">

    <!-- Lockup co-firmado: logo partido + persona -->
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/logo-impulso.jpg" alt="IMPULSO Río Negro" class="h-9 w-auto" />
      <div class="border-l border-gray-200 pl-3 leading-tight">
        <div class="font-montserrat font-black text-[14px] uppercase tracking-tight text-[#0E0B12]">Nicolás Suárez Colman</div>
        <div class="font-montserrat font-bold text-[10px] uppercase tracking-widest text-[#6A287F]">Presidente · IMPULSO Río Negro</div>
      </div>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex items-center gap-1">
      {nav.map(item => (
        <a
          href={item.href}
          class:list={[
            'font-montserrat font-bold text-[12px] uppercase tracking-wider px-4 py-2 rounded transition-colors',
            current === item.href || (item.href !== '/' && current.startsWith(item.href))
              ? 'text-[#6A287F] bg-[#ede1f2]'
              : 'text-[#0E0B12] hover:text-[#6A287F] hover:bg-[#ede1f2]'
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/sumate"
        class="font-montserrat font-black text-[12px] uppercase tracking-wider px-5 py-2 rounded bg-[#F97B00] text-white hover:bg-orange-600 transition-colors ml-2"
      >
        Sumate
      </a>
    </nav>

    <!-- Hamburger mobile -->
    <button id="menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Abrir menú">
      <span class="block w-6 h-0.5 bg-[#0E0B12]"></span>
      <span class="block w-6 h-0.5 bg-[#0E0B12]"></span>
      <span class="block w-6 h-0.5 bg-[#0E0B12]"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-6 pb-4">
    {nav.map(item => (
      <a
        href={item.href}
        class="block font-montserrat font-bold text-[13px] uppercase tracking-wider py-3 border-b border-gray-100 text-[#0E0B12] hover:text-[#6A287F]"
      >
        {item.label}
      </a>
    ))}
    <a href="/sumate" class="mt-3 block text-center font-montserrat font-black text-[13px] uppercase tracking-wider py-3 rounded bg-[#F97B00] text-white">Sumate</a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
