---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sumate a IMPULSO Río Negro" description="Voluntarios, fiscales, militantes. Construimos juntos el partido liberal de Río Negro.">

  <div class="bg-[#6A287F] py-14 px-6">
    <div class="max-w-6xl mx-auto">
      <span class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-[#F97B00] block mb-3">Participá</span>
      <h1 class="font-montserrat font-black text-5xl text-white uppercase tracking-tight">Sumate a IMPULSO</h1>
      <p class="text-white/70 mt-3 max-w-xl">No hay aparato. No hay padrino. Solo personas convencidas de que Río Negro puede más.</p>
    </div>
  </div>
  <div class="h-1 w-full" style="background:linear-gradient(90deg,#6A287F,#F97B00,#55A3B2)"></div>

  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

      <!-- Izquierda: Texto -->
      <div>
        <h2 class="font-montserrat font-black text-3xl text-[#6A287F] uppercase mb-6">¿Cómo podés sumarte?</h2>
        <div class="space-y-5">
          {[
            ['🗳️', 'Fiscal electoral', 'Cuidá el voto el día de las elecciones. Capacitación incluida.'],
            ['📣', 'Voluntario de campaña', 'Recorridas, eventos, difusión en tu barrio o ciudad.'],
            ['📱', 'Difusión en redes', 'Compartí contenido y hacé crecer el partido digitalmente.'],
            ['📬', 'Estar informado', 'Recibí novedades del partido sin compromiso adicional.'],
          ].map(([icon, titulo, desc]) => (
            <div class="flex gap-4 bg-gray-50 rounded-xl p-5">
              <span class="text-2xl">{icon}</span>
              <div>
                <h3 class="font-montserrat font-bold text-[13px] uppercase tracking-wide text-[#6A287F] mb-1">{titulo}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>

        <blockquote class="mt-8 border-l-4 border-[#F97B00] pl-5 py-1">
          <p class="font-montserrat font-bold text-[#6A287F] text-lg leading-snug">
            "Liberal de acá. Eso somos."
          </p>
        </blockquote>
      </div>

      <!-- Derecha: Formulario -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8">
        <h3 class="font-montserrat font-black text-xl text-[#6A287F] uppercase mb-6">Completá tus datos</h3>

        <form
          name="sumate"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="sumate" />
          <input type="hidden" name="bot-field" />

          <div>
            <label class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-gray-500 block mb-1.5">
              Nombre completo *
            </label>
            <input type="text" name="nombre" required
              class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#6A287F] transition-colors"
              placeholder="Tu nombre y apellido" />
          </div>

          <div>
            <label class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-gray-500 block mb-1.5">
              Ciudad / Localidad *
            </label>
            <input type="text" name="ciudad" required
              class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#6A287F] transition-colors"
              placeholder="Ej: Cipolletti, Bariloche, Roca..." />
          </div>

          <div>
            <label class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-gray-500 block mb-1.5">
              WhatsApp *
            </label>
            <input type="tel" name="telefono" required
              class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#6A287F] transition-colors"
              placeholder="+54 9 299 XXX XXXX" />
          </div>

          <div>
            <label class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-gray-500 block mb-1.5">
              Email
            </label>
            <input type="email" name="email"
              class="w-full border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-[#6A287F] transition-colors"
              placeholder="tu@email.com" />
          </div>

          <div>
            <label class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-gray-500 block mb-2">
              ¿Cómo querés participar? *
            </label>
            <div class="space-y-2">
              {[
                ['fiscal', 'Fiscal electoral'],
                ['voluntario', 'Voluntario de campaña'],
                ['redes', 'Difusión en redes'],
                ['informado', 'Solo quiero estar informado'],
              ].map(([val, label]) => (
                <label class="flex items-center gap-3 cursor-pointer">
                  <input type="radio" name="participacion" value={val} required
                    class="accent-[#6A287F] w-4 h-4" />
                  <span class="text-sm text-gray-700">{label}</span>
                </label>
              ))}
            </div>
          </div>

          <button type="submit"
            class="w-full font-montserrat font-black text-[13px] uppercase tracking-widest bg-[#F97B00] hover:bg-orange-600 text-white py-4 rounded-lg transition-colors mt-2">
            SUMATE
          </button>

          <p class="text-xs text-gray-400 text-center leading-relaxed">
            Te contactamos en los próximos días.<br>
            Mientras tanto, seguinos en <a href="https://instagram.com/impulsorionegro" class="text-[#6A287F] hover:underline">@impulsorionegro</a>.
          </p>
        </form>
      </div>

    </div>
  </section>

</Layout>
