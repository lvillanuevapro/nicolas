---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const columnas = await getCollection('columnas', c => c.data.tipo !== 'enlace');
  return columnas.map(col => ({ params: { slug: col.id }, props: { col } }));
}

const { col } = Astro.props;
const { Content } = await render(col);

function formatFecha(d: Date) {
  return d.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title={`${col.data.titulo} — Nicolás Suárez Colman`} description={col.data.descripcion}>

  <div class="bg-[#6A287F] py-14 px-6">
    <div class="max-w-3xl mx-auto">
      <a href="/columnas" class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-[#F97B00] hover:text-white transition-colors mb-3 block">← Todas las columnas</a>
      <span class="font-montserrat font-bold text-[10px] uppercase tracking-widest text-white/50 block mb-4">{formatFecha(col.data.fecha)}</span>
      <h1 class="font-montserrat font-black text-4xl md:text-5xl text-white uppercase tracking-tight leading-tight">
        {col.data.titulo}
      </h1>
      <p class="text-white/60 mt-4 text-lg leading-relaxed">{col.data.descripcion}</p>
    </div>
  </div>
  <div class="h-1 w-full" style="background:linear-gradient(90deg,#6A287F,#F97B00,#55A3B2)"></div>

  <article class="py-16 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="prose prose-lg max-w-none
                  prose-headings:font-montserrat prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tight prose-headings:text-[#6A287F] prose-headings:mt-10 prose-headings:mb-4
                  prose-p:text-gray-600 prose-p:leading-relaxed prose-p:mb-5
                  prose-strong:text-[#0E0B12]
                  prose-a:text-[#6A287F] prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>

      <div class="mt-14 pt-10 border-t border-gray-100 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-[#6A287F] flex items-center justify-center shadow-sm">
          <span class="font-montserrat font-black text-white text-lg">N</span>
        </div>
        <div>
          <div class="font-montserrat font-black text-[13px] uppercase tracking-wide text-[#0E0B12]">Nicolás Suárez Colman</div>
          <div class="font-montserrat font-bold text-[11px] uppercase tracking-widest text-[#55A3B2]">Presidente · IMPULSO Río Negro</div>
        </div>
      </div>

    </div>
  </article>

  <div class="bg-[#ede1f2] py-12 px-6 text-center">
    <h3 class="font-montserrat font-black text-xl text-[#6A287F] uppercase mb-3">¿Compartís estas ideas?</h3>
    <p class="text-gray-600 mb-6">Sumate a IMPULSO Río Negro.</p>
    <a href="/sumate"
       class="font-montserrat font-black text-[13px] uppercase tracking-widest bg-[#F97B00] hover:bg-orange-600 text-white px-10 py-4 rounded transition-colors">
      Sumate
    </a>
  </div>

</Layout>
